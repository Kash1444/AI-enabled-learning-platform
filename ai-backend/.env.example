# Copy this file to .env and adjust as needed.
# NEVER commit your real .env file.

# ---------------------------------------------------------------------
# General
# ---------------------------------------------------------------------
ENVIRONMENT=development

# DEMO_MODE=true -> the entire platform (competency scoring, skill gaps,
# recommendations, MCQ generation, AI assistant) works with ZERO external
# credentials. Set to false once you have configured a real LLM provider
# below and want to use it.
DEMO_MODE=true

# ---------------------------------------------------------------------
# Database (SQLite by default - zero setup)
# ---------------------------------------------------------------------
DATABASE_URL=sqlite:///./storage/app.db

# ---------------------------------------------------------------------
# CORS - comma separated list of allowed frontend origins
# ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------
# File uploads
# ---------------------------------------------------------------------
UPLOAD_DIR=storage/uploads
CHROMA_DIR=storage/chroma
MAX_UPLOAD_MB=20
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.pptx,.txt

# ---------------------------------------------------------------------
# Server bind address for `python run.py`
# ---------------------------------------------------------------------
# 8000 is the conventional default and what the frontend falls back to.
# Change it if another local service already holds the port, and set the
# matching VITE_API_URL in frontend/.env.
HOST=127.0.0.1
PORT=8000

# ---------------------------------------------------------------------
# LLM provider (leave blank / DEMO_MODE=true to skip entirely)
# ---------------------------------------------------------------------
# demo | anthropic | openai
# Setting a provider here has no effect until DEMO_MODE=false.
LLM_PROVIDER=demo

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------
# Embeddings / RAG
# ---------------------------------------------------------------------
# auto | sentence-transformers | hash
# "auto" tries sentence-transformers and falls back to the dependency-free
# hashing embedder if it isn't installed (it needs torch, which has no
# Python 3.14 wheels yet). Retrieval works either way; sentence-transformers
# just ranks better. Set "hash" to skip the import attempt entirely.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4

# ---------------------------------------------------------------------
# Skill gap thresholds
# ---------------------------------------------------------------------
GAP_HIGH_THRESHOLD=1.5
GAP_MEDIUM_THRESHOLD=0.75

# ---------------------------------------------------------------------
# Adaptive learning
# ---------------------------------------------------------------------
ADAPTIVE_EASY_MAX_PCT=50
ADAPTIVE_INTERMEDIATE_MAX_PCT=75
COMPETENCY_UPDATE_WEIGHT=0.4

# ---------------------------------------------------------------------
# iGOT / NSSTA (real integration placeholders - leave blank to use mock data)
# ---------------------------------------------------------------------
IGOT_API_BASE_URL=
IGOT_API_KEY=
NSSTA_API_BASE_URL=
NSSTA_API_KEY=

# ---------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------
API_AUTH_ENABLED=false
API_STATIC_TOKEN=
