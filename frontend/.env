# Origin of the AI backend (ai-backend/).
#
# This must be the server ORIGIN only, with no /api suffix: src/services/
# apiClient.js already prefixes every request path with /api, so adding it
# here would produce /api/api/... and every call would 404.
#
# Must match HOST/PORT in ai-backend/.env. 8000 is the conventional default,
# but it is already taken by Splunk on this machine, so both sides use 8001.
VITE_API_URL=http://localhost:8001
