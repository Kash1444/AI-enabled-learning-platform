# Python / ai-vision
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# Trained models are large binaries - export them, don't commit them.
# See ai-vision/CLAUDE.md. Covers SavedModel directories as well as single-file exports.
ai-vision/models/
models/*.h5
models/*.tflite
*.tflite
*.h5

